source "https://rubygems.org"

# We use the official GitHub Pages gem group. This tells GitHub exactly how to 
# resolve all dependencies and native extensions (like Nokogiri) without breaking.
gem "github-pages", group: :jekyll_plugins

# The default theme you are using
gem "minima", "~> 2.5"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.12"
end

# We can completely remove the old Windows/JRuby platform blocks as they aren't 
# needed for your Mac local setup or GitHub's Linux runners.